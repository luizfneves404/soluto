{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "soluto",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-10",
	"compatibility_flags": ["nodejs_compat"],
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"migrations": [
		{
			"tag": "chat-state-do-v1",
			"new_classes": ["ChatStateDurableObject"]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_STATE",
				"class_name": "ChatStateDurableObject"
			}
		]
	}
