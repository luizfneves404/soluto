OPENAI_API_KEY=your-api-key
TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET_TOKEN=replace-with-random-secret

# Mastra workspace: Cloudflare R2 + Daytona (optional — omit R2_* to disable). Uses FUSE (s3fs) for /data.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
DAYTONA_API_KEY=
# Optional; defaults per https://www.daytona.io/docs
# DAYTONA_API_URL=
# DAYTONA_TARGET=
DAYTONA_SANDBOX_ID=soluto-agent-sandbox
DAYTONA_SANDBOX_TIMEOUT_MS=600000
# Pre-built snapshot for faster cold starts — see Mastra Daytona workspace docs
DAYTONA_SNAPSHOT_ID=
